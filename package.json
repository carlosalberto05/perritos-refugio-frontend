{
  "name": "perritos-refugio-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "next dev",
    "db": "json-server --watch db.json --port 3001",
    "dev:all": "concurrently \"npm run db\" \"npm run dev\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "lucide-react": "^0.555.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "baseline-browser-mapping": "^2.11.35",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "json-server": "^1.0.0-beta.15",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "ws": "^8.22.1",
    "form-data": "^4.0.6",
    "yaml": "^2.9.1",
    "flatted": "^3.4.4",
    "js-yaml": "^4.3.2",
    "ajv@^6.12.4": "^6.15.0",
    "minimatch@^3.1.2": "^3.1.5",
    "minimatch@^10.2.2": "^11.0.5",
    "brace-expansion@^1.1.7": "^1.1.21",
    "rollup": "^4.68.0",
    "@humanfs/node": "^0.16.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
